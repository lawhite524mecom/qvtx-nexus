{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "QVTX Codon",
  "version": "1.0.0",
  "description": "Design system for the QVTX ecosystem. Extracted from qvtx-nexus and qvtx-os, reconciled against the QUANTVESTRIX brand of record.",
  "themes": ["dna", "ice"],
  "defaultTheme": "dna",
  "brand": {
    "goldXpress": { "value": "#F5A623", "role": "primary", "note": "Brand of record. CTAs, highlights." },
    "goldSignal": { "value": "#FFD700", "role": "glow", "note": "On-dark telemetry and glow only. Was the app's de facto gold (98 usages)." },
    "goldOnLight": { "value": "#B45309", "role": "text", "contrastOnIce": 4.64 },
    "navy": { "value": "#0A2540", "role": "text-on-primary", "contrastOnGold": 7.67 },
    "charcoal": { "value": "#2E2E2E", "role": "body-text-light" },
    "ice": { "value": "#F4F6F8", "role": "text-on-dark", "contrastOnPanel": 17.76 }
  },
  "bases": {
    "note": "The quaternary bases ARE the accent palette. Base pairs are visual complements: A-T (cyan/gold), C-G (crimson/green). Bit mapping matches qvtx-os/kernel/constants.js.",
    "A": {
      "name": "Adenine",
      "bits": "00",
      "fill": "#00D4FF",
      "textOnDark": "#00D4FF",
      "textOnLight": "#0E7490",
      "semanticRole": "info",
      "contrastOnPanel": 10.87,
      "contrastOnIce": 4.95
    },
    "C": {
      "name": "Cytosine",
      "bits": "01",
      "fill": "#E11D48",
      "textOnDark": "#FB7185",
      "textOnLight": "#BE123C",
      "semanticRole": "danger",
      "contrastOnPanel": 4.1,
      "fillFailsAsText": true,
      "note": "Source DNA system specified purple #8B5CF6. Purple is excluded from branded output; crimson is the true visual complement of Guanine green. The #E11D48 fill measures 4.10:1 on the dark panel and must not carry body text — use #FB7185.",
      "textOnDarkContrast": 7.15,
      "textOnLightContrast": 5.8
    },
    "G": {
      "name": "Guanine",
      "bits": "10",
      "fill": "#10B981",
      "textOnDark": "#10B981",
      "textOnLight": "#047857",
      "semanticRole": "success",
      "contrastOnPanel": 7.58,
      "contrastOnIce": 5.06
    },
    "T": {
      "name": "Thymine",
      "bits": "11",
      "fill": "#F5A623",
      "textOnDark": "#F5A623",
      "textOnLight": "#B45309",
      "semanticRole": "warning",
      "contrastOnPanel": 9.49,
      "contrastOnIce": 4.64,
      "note": "Thymine and the brand primary are the same value. The brand primary IS a base."
    }
  },
  "surfaces": {
    "dna": {
      "sunken": { "value": "#080910", "provenance": "observed" },
      "canvas": { "value": "#0A0B14", "provenance": "observed: src/Layout.jsx" },
      "panel": { "value": "#0D0E16", "provenance": "observed: GlassCard, StatCard (24 usages)" },
      "raised": { "value": "#0F1019", "provenance": "observed: PortalCard" },
      "overlay": { "value": "#14151F", "provenance": "derived" }
    },
    "ice": {
      "sunken": { "value": "#E8ECF0" },
      "canvas": { "value": "#F4F6F8" },
      "panel": { "value": "#FBFCFD" },
      "raised": { "value": "#FFFFFF" },
      "overlay": { "value": "#FFFFFF" }
    }
  },
  "text": {
    "onDark": {
      "primary": { "value": "#F4F6F8", "contrastOnPanel": 17.76 },
      "secondary": { "value": "#A8B2C1", "contrastOnPanel": 8.98 },
      "muted": { "value": "#7D8898", "contrastOnPanel": 5.36 }
    },
    "onLight": {
      "primary": { "value": "#0A2540", "contrastOnIce": 14.34 },
      "secondary": { "value": "#2E2E2E", "contrastOnIce": 12.54 },
      "muted": { "value": "#5A6674", "contrastOnIce": 5.4 }
    },
    "rejected": {
      "value": "#6B7687",
      "reason": "Measured 4.18:1 on the dark panel. Fails the 4.5:1 body-text floor."
    }
  },
  "typography": {
    "families": {
      "display": { "stack": "'Orbitron', 'Trebuchet MS', sans-serif", "weights": [600, 700, 900], "provenance": "already shipped: 74 .font-orbitron usages" },
      "text": { "stack": "'Inter', 'Helvetica Neue', Arial, sans-serif", "weights": [400, 500, 600, 700], "provenance": "already shipped: body default" },
      "data": { "stack": "'JetBrains Mono', 'Courier New', monospace", "weights": [400, 500, 700], "provenance": "replaces the undefined font-mono (82 usages) and qvtx-os Courier New" }
    },
    "scale": {
      "caption": "0.75rem",
      "small": "0.875rem",
      "body": "1rem",
      "lead": "1.25rem",
      "h3": "1.5rem",
      "h2": "2rem",
      "h1": "2.75rem",
      "display": "4rem"
    },
    "tracking": { "display": "0.02em", "eyebrow": "0.18em" }
  },
  "radius": {
    "control": { "value": "0.5rem", "provenance": "rounded-lg, 176 usages" },
    "card": { "value": "0.75rem", "provenance": "rounded-xl, 371 usages — the dominant radius" },
    "panel": { "value": "1rem", "provenance": "rounded-2xl, 50 usages" },
    "portal": { "value": "1.5rem", "provenance": "rounded-3xl, 7 usages" },
    "pill": { "value": "9999px" }
  },
  "spacing": {
    "note": "PHI = 1.618034. Fibonacci approximates PHI on whole pixels, so the scale stays PHI-true without fractional values. Use the phi scale for section and stack rhythm; keep component internals on the 4px grid.",
    "phi": { "1": "8px", "2": "13px", "3": "21px", "4": "34px", "5": "55px", "6": "89px", "7": "144px" },
    "grid": { "1": "4px", "2": "8px" }
  },
  "motion": {
    "instant": "120ms",
    "fast": { "value": "200ms", "provenance": "observed 31x — control state changes" },
    "base": { "value": "320ms", "provenance": "observed duration-300 13x — card transitions" },
    "slow": { "value": "520ms", "provenance": "observed duration-500 6x — portal reveals" },
    "pulse": { "value": "1500ms", "provenance": "observed: qvtx-os live-dot" },
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeLift": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "effects": {
    "glowAdenine": { "value": "0 0 20px rgb(0 212 255 / 0.6)", "provenance": "observed .dna-glow-cyan, kept exactly" },
    "glowThymine": { "value": "0 0 20px rgb(245 166 35 / 0.6)" },
    "glowSignal": { "value": "0 0 20px rgb(255 215 0 / 0.6)", "provenance": "observed .dna-glow-gold" },
    "note": "Glow is a dark-surface effect only. It is set to none in the Ice theme."
  },
  "borders": {
    "dna": {
      "subtle": { "value": "rgb(244 246 248 / 0.10)", "provenance": "observed border-white/10" },
      "default": { "value": "rgb(244 246 248 / 0.20)", "provenance": "observed border-white/20" },
      "accent": { "value": "rgb(0 212 255 / 0.40)", "provenance": "observed hover:border-cyan-500/40" }
    }
  },
  "rarity": {
    "note": "Re-derived on the base palette as an ascending-heat ramp. Steps differ in lightness as well as hue, and the purple EPIC tier is retired.",
    "COMMON": { "value": "#94A3B8", "stars": 1 },
    "RARE": { "value": "#00D4FF", "stars": 2, "base": "A" },
    "EPIC": { "value": "#10B981", "stars": 3, "base": "G", "was": "#A78BFA" },
    "LEGENDARY": { "value": "#F5A623", "stars": 4, "base": "T", "was": "#FBBF24" },
    "MYTHIC": { "value": "#E11D48", "stars": 5, "base": "C", "was": "#F472B6" }
  },
  "retired": {
    "--qvtx-cyan": "#00d4ff -> codon.bases.A (same value, named role)",
    "--qvtx-gold": "#ffd700 -> brand.goldXpress #F5A623; #ffd700 survives as brand.goldSignal",
    "violet|purple|fuchsia|indigo": "139 shipped usages -> info or danger by role. Purple is excluded from branded output.",
    "#8844FF": "qvtx-os accent -> brand.goldXpress",
    "#00FF88": "qvtx-os live -> bases.G #10B981",
    "#FF4444": "-> bases.C",
    "#FFAA00": "-> bases.T",
    "Courier New": "-> typography.families.data"
  }
}
